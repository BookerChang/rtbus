menu "RTBus Library"
config RTBUS_LIB
    bool "Enable RTBus Library"
    default n

config RTBUS_ITERABLE_ENTRY
    bool "Register rtbus tasks through Zephyr iterable sections"
    depends on RTBUS_LIB
    default y
    help
      When enabled, rtbus tasks are registered with STRUCT_SECTION_ITERABLE.
      When disabled, rtbus_init() uses the explicit rtbus_entry_t table passed
      by the caller.

config RTBUS_DELAYED_EVENT_DEPTH
    int "Delayed event queue depth"
    depends on RTBUS_LIB
    default 8
    help
      Maximum number of delayed events owned by the rtbus facade.

config RTBUS_DELAYED_EVENT_PAYLOAD_MAX
    int "Delayed event payload size"
    depends on RTBUS_LIB
    default 32
    help
      Maximum payload bytes copied into one delayed event.

config RTBUS_NATIVE_SERVICE
    bool "Enable RTBus native service subsystem"
    depends on RTBUS_LIB
    depends on FLASH_MAP
    depends on MULTITHREADING
    depends on EVENTS
    depends on SERIAL
    depends on GPIO
    select CRC
    default n
    help
      Enable the RTBus native service. This subsystem loads the RTBus image,
      installs the existing runtime ABI table, and runs the native application
      thread.

config RTBUS_DIAGNOSTICS_SERVICE
    bool "Enable RTBus diagnostics service"
    depends on RTBUS_NATIVE_SERVICE
    default y
    help
      Enable the RTBus diagnostics task used by native applications and
      Arduino sketches to exercise the runtime post, result write-back, and
      completion wait path. Disable this for minimal production runtimes that
      do not need built-in diagnostics.

config RTBUS_RUNTIME_TIMEOUT_MAX_MS
    int "Maximum RTBus runtime wait timeout in milliseconds"
    default 100
    range 1 60000
    depends on RTBUS_NATIVE_SERVICE
    help
      Maximum timeout passed to the RTBus runtime event wait. This is also used
      when RTBus has no pending delayed event.

config RTBUS_RUNTIME_THREAD_STACK_SIZE
    int "RTBus runtime thread stack size"
    default 1024
    range 512 8192
    depends on RTBUS_NATIVE_SERVICE
    help
      Stack size for the Zephyr thread that initializes RTBus and runs the
      rtbus_process() loop. Increase this on profiles whose RTBus tasks call
      stack-heavy subsystems such as Bluetooth settings loading.

config RTBUS_RUNTIME_THREAD_PRIORITY
    int "RTBus runtime thread priority"
    default 9
    range 0 15
    depends on RTBUS_NATIVE_SERVICE
    help
      Preemptive Zephyr priority used by the RTBus runtime thread.

config RTBUS_IMAGE_RAM_MAX
    int "Maximum runtime RAM declared by an RTBus image"
    default 8192
    range 0 8192
    depends on RTBUS_NATIVE_SERVICE
    help
      Maximum private runtime RAM, in bytes, that an RTBus image may declare in
      its header.
endmenu
