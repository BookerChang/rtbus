menu "WisMOD Firmware Component Library"

config WISMOD_FW_COMPONENT_LIB
    bool "Enable WisMOD firmware component library"
    default n
    depends on FLASH_MAP
    select CRC
    help
      Enable storage and validation for a small replaceable firmware
      component payload stored outside the main MCUboot image slots.

config WISMOD_FW_COMPONENT_RAM_MAX
    int "Maximum runtime RAM declared by a firmware component"
    default 8192
    range 0 8192
    depends on WISMOD_FW_COMPONENT_LIB
    help
      Maximum private runtime RAM, in bytes, that a component image may
      declare in its header.

config WISMOD_FW_COMPONENT_STORE_DIRECT_FLASH
    bool "Store component DFU payload directly in component slot flash"
    default n
    depends on WISMOD_FW_COMPONENT_LIB
    help
      Write received component DFU payloads directly to component_slot_partition
      instead of staging them in shared_upgrade_ram first. Keep this disabled
      for boards that rely on RAM staging rollback behavior.

endmenu
